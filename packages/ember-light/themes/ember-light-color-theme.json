  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a59fa0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation",
      "scope": [
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#a59fa0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Declaration types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#1c8ca8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#e14775",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#918c8e"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#cc7a0a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7058be"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#269d69"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#1c8ca8"
      }
    },
    {
      "name": "Library types",
      "scope": [
        "support.type"
      ],
      "settings": {
        "foreground": "#1c8ca8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#29242a"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e16032",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#29242a"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#706b6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language arguments",
      "scope": [
        "variable.language.arguments"
      ],
      "settings": {
        "foreground": "#7058be"
      }
    },
    {
      "name": "Built-in constants",
      "scope": [
        "support.constant"
      ],
      "settings": {
        "foreground": "#7058be"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#cc7a0a"
      }
    },
    {
      "name": "Regular expression delimiters",
      "scope": [
        "string.regexp punctuation.definition.string.begin",
        "string.regexp punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1c8ca8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#269d69"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name",
        "support.type.property-name.json",
        "support.type.property-name.jsonc"
      ],
      "settings": {
        "foreground": "#29242a",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#cc7a0a"
      }
    },
    {
      "name": "Raw markup",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#e16032"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#29242a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#29242a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#269d69",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#269d69"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#cc7a0a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e14775",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Comment annotations",
      "scope": [
        "comment keyword.codetag.notation"
      ],
      "settings": {
        "foreground": "#7058be"
      }
    },
    {
      "name": "Template delimiters",
      "scope": [
        "keyword.other.template.begin",
        "keyword.other.template.end",
        "punctuation.template-string.element.begin",
        "punctuation.template-string.element.end",
        "punctuation.definition.string.template.begin",
        "punctuation.definition.string.template.end",
        "string.quoted.template punctuation.definition.string.begin",
        "string.quoted.template punctuation.definition.string.end",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#e14775"
      }
    },
    {
      "name": "Embedded expressions",
      "scope": [
        "meta.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#29242a"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#1c8ca8",
    "type": "#1c8ca8",
    "class": "#1c8ca8",
    "enum": "#1c8ca8",
    "interface": "#1c8ca8",
    "struct": "#1c8ca8",
    "typeParameter": "#1c8ca8",
    "parameter": {
      "foreground": "#e16032",
      "italic": true
    },
    "variable": "#29242a",
    "property": "#29242a",
    "enumMember": "#7058be",
    "event": "#29242a",
    "function": "#269d69",
    "method": "#269d69",
    "macro": "#1c8ca8",
    "keyword": "#e14775",
    "modifier": {
      "foreground": "#e14775",
      "italic": true
    },
    "comment": {
      "foreground": "#a59fa0",
      "italic": true
    },
    "string": "#cc7a0a",
    "number": "#7058be",
    "regexp": "#cc7a0a",
    "operator": "#e14775",
    "decorator": "#269d69",
    "variable.readonly": "#7058be",
    "property.readonly": "#29242a",
    "variable.defaultLibrary": "#29242a",
    "function.defaultLibrary": "#269d69",
    "method.defaultLibrary": "#269d69"
  }
}
